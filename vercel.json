{
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/cron-backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-backup",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|.*\\.).*)", "destination": "/index.html" }
  ]
}